# PostgreSQL Configuration
POSTGRES_DB=gis
POSTGRES_USER=renderaccount
POSTGRES_PASSWORD=renderpassword

# OSM Import Configuration
OSM_IMPORT_CACHE=2048  # Memory cache in MB (adjust based on available RAM)
THREADS=4               # Number of parallel threads for import

# Database Performance Tuning
# Adjust these based on your available RAM
SHARED_BUFFERS=2GB
WORK_MEM=50MB
MAINTENANCE_WORK_MEM=10GB
AUTOVACUUM_WORK_MEM=2GB
EFFECTIVE_CACHE_SIZE=24GB
